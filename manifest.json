{
  "manifest_version": 3,
  "name": "Zendesk Ticket Tracker",
  "version": "2.0.0",
  "description": "Track open, new, and team tickets on Zendesk with a floating widget. Double-click to count. View daily, weekly, and monthly stats with charts. Cloud sync across devices.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "*://*.zendesk.com/*",
    "https://firestore.googleapis.com/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zendesk.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "widget.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Zendesk Ticket Tracker"
  }
}
