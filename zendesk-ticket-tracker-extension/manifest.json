{
  "manifest_version": 3,
  "name": "Zendesk Ticket Tracker",
  "version": "5.4",
  "description": "Premium Zendesk ticket analytics: leaderboard, hourly pacing, calendar inspector, Excel export, cloud sync, and level ranks.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "oauth2": {
    "client_id": "360976988892-5vuq71m7k6a3oeir63rbclvnk1c3ku40.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "permissions": [
    "storage",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "*://*.zendesk.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://api.telegram.org/*",
    "https://slack.com/*",
    "https://*.slack.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zendesk.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "widget.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Zendesk Ticket Tracker"
  }
}
